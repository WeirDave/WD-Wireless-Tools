# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# Claude Code worktrees + dev tooling
.claude/

# Atomic-write temp files (created by edit tools when sync races)
*.tmp.*

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Ekahau project files (user data — never commit)
*.esx

# Sensitive session/cookie data
*.cookies
*.session
cookies.json
cookies.enc

# Scratch/working files — never commit (may contain personal/sensitive docs)
tmp/

# AI-handoff notes — internal working notes, not for the public repo
PROJECT_MEMORY.md


# Windows reserved device names, created by a mistyped `> nul` redirect.
# Harmless as content, but one `git add -A` from being committed.
nul
NUL

# Local diagnostics - real paths and hostnames, never published.
logs/
*.log
share_recipients.json

# Selenium Manager's downloads. `webdriver.Firefox()` fetches geckodriver on
# first use and drops it, plus its metadata, into the working directory - a
# 4 MB binary one `git add -A` away from the repository. The browser tests in
# tests/test_dev_toolbar_browser.py are what triggers this.
geckodriver/
chromedriver/
msedgedriver/
se-metadata.json
